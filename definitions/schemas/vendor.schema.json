{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "Sensora Vendor Definition",

  "description": "Schema for Sensora hardware vendor definitions.",

  "type": "object",

  "additionalProperties": false,

  "required": [
    "id",
    "name"
  ],

  "properties": {

    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string"
    },

    "website": {
      "type": "string",
      "format": "uri"
    },

    "country": {
      "type": "string"
    },

    "metadata": {
      "type": "object"
    }

  }
}
