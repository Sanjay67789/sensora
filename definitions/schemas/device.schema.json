{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "Sensora Device Definition",

  "description": "Flexible hardware definition schema for Sensora.",

  "type": "object",

  "additionalProperties": false,


  "required": [
    "id",
    "name",
    "vendor"
  ],


  "properties": {


    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },


    "name": {
      "type": "string"
    },


    "vendor": {
      "type": "string"
    },


    "description": {
      "type": [
        "string",
        "null"
      ]
    },


    "buses": {

      "oneOf": [

        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        {
          "type": "null"
        }

      ]

    },


    "addresses": {

      "oneOf": [

        {
          "type": "array",

          "items": {
            "type": "string"
          }

        },


        {
          "type": "object",

          "additionalProperties": {

            "oneOf": [

              {
                "type": "array",

                "items": {
                  "type": "string"
                }

              },


              {
                "type": "string"
              }

            ]

          }

        },


        {
          "type": "null"
        }

      ]

    },


    "chip_id": {

      "oneOf": [

        {
          "type": "string"
        },


        {
          "type": "object",

          "additionalProperties": {

            "type": "string"

          }

        },


        {
          "type": "null"
        }

      ]

    },


    "driver_module": {

      "type": [
        "string",
        "null"
      ]

    },


    "interfaces": {

      "oneOf": [

        {
          "type": "object",

          "additionalProperties": true

        },


        {
          "type": "null"
        }

      ]

    },


    "identification": {

      "oneOf": [

        {
          "type": "object",

          "additionalProperties": true

        },


        {
          "type": "null"
        }

      ]

    },


    "driver": {

      "oneOf": [

        {
          "type": "object",

          "additionalProperties": true

        },


        {
          "type": "null"
        }

      ]

    },


    "linux": {

      "oneOf": [

        {
          "type": "object",

          "additionalProperties": true

        },


        {
          "type": "null"
        }

      ]

    },


    "measurements": {

      "oneOf": [

        {
          "type": "array",

          "items": {
            "type": "string"
          }

        },


        {
          "type": "null"
        }

      ]

    },


    "electrical": {

      "oneOf": [

        {
          "type": "object",

          "additionalProperties": true

        },


        {
          "type": "null"
        }

      ]

    },


    "package": {

      "oneOf": [

        {
          "type": "string"
        },


        {
          "type": "object"
        },


        {
          "type": "null"
        }

      ]

    },


    "features": {

      "oneOf": [

        {
          "type": "array",

          "items": {
            "type": "string"
          }

        },


        {
          "type": "object",

          "additionalProperties": true

        },


        {
          "type": "null"
        }

      ]

    },


    "metadata": {

      "oneOf": [

        {
          "type": "object",

          "additionalProperties": true

        },


        {
          "type": "null"
        }

      ]

    }

  },


  "anyOf": [

    {
      "required": [
        "interfaces"
      ]
    },


    {
      "required": [
        "buses"
      ]
    },


    {
      "required": [
        "addresses"
      ]
    }

  ]

}
